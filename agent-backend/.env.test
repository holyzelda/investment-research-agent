# 测试环境启动与 Nacos 连接配置；业务配置见 configs/application.yml 或 Nacos。
APP_NAME=iresearch-agent-service
APP_VERSION=0.1.0
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=9089

APP_LOG_LEVEL=DEBUG
APP_LOG_FORMAT="{time:YYYY-MM-DD HH:mm:ss.SSS} | {level} | {name}:{function}:{line} - {message}"
APP_LOG_DIR=./logs
APP_LOG_ROTATION=00:00
APP_LOG_RETENTION="7 days"

APP_CORS_ALLOW_ORIGINS=*
APP_CORS_ALLOW_CREDENTIALS=true
APP_CORS_ALLOW_METHODS=*
APP_CORS_ALLOW_HEADERS=*

NACOS_ENABLED=true
NACOS_SERVER_ADDR=internal-2-58.example.invalid:8848
NACOS_NAMESPACE=test
NACOS_GROUP=DEFAULT_GROUP
NACOS_PROFILE=test
NACOS_DISCOVERY_SERVICE_NAME=iresearch-agent-service
