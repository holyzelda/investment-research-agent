# 生产环境启动与 Nacos 连接配置；部署时替换 Nacos 地址、命名空间和认证信息。
APP_NAME=ir-agent
APP_VERSION=0.1.0
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=9089

NACOS_ENABLED=true
NACOS_SERVER_ADDR=internal-1-55.example.invalid:8848,internal-2-56.example.invalid:8848,internal-2-57.example.invalid:8848
NACOS_NAMESPACE=539434de-e30b-4988-ac81-7f9d0bd65ad7
NACOS_GROUP=DEFAULT_GROUP
NACOS_PROFILE=prod
NACOS_DISCOVERY_SERVICE_NAME=ir-agent
