# 根级忽略（各子应用 agent-frontend / agent-backend 另有更细的 .gitignore）

# ===== OS =====
.DS_Store
Thumbs.db

# ===== IDE =====
.idea/
.vscode/
*.swp

# ===== 日志 =====
*.log
logs/

# ===== Python（兜底） =====
__pycache__/
*.py[cod]
.venv/
venv/

# ===== Node（兜底） =====
node_modules/

# ===== 环境变量（兜底：本地私有覆盖不入库） =====
.env.local
.env.*.local

.claude
CLAUDE.md
AGENTS.md
CONTEXT.md
agent-backend/CLAUDE.md
agent-frontend/CLAUDE.md

.mypython/
.pip_install_wrapper.py

my_projects

.qoder-collab-runtime
.qoder-sop-runtime
.qoder
hooks
docs/manual

# 私有配置、访问令牌和工具运行缓存不进入公开仓库
.env
.env.*
!.env.example
!agent-backend/.env.test
!agent-backend/.env.prod
!agent-frontend/.env
!agent-frontend/.env.development
!agent-frontend/.env.example
!agent-frontend/.env.production
!agent-frontend/.env.staging
**/.superpowers/
**/.playwright-mcp/
**/.playwright-cli/
**/.vite/
**/tools/_cache/
**/tools/_tmp_download/
**/tools/_feishu_poc_out.txt
**/.shanxi_scan.json
*.pem
*.p12
*.pfx
*.key


